# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret
# Optional, shown with their defaults (Swagger UI: http://localhost:3007/api/docs)
# APP_NAME=Prism
# API_VERSION=1
# SWAGGER_PATH=api/docs

# Health check
HEALTH_CHECK_ENABLED=false
# HEALTH_DISK_PATH is optional — defaults to "/" on Linux/macOS or "C:\" on Windows
# HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD=0.9

# Throttler — global TTL is in milliseconds, per-route TTLs in seconds
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10
THROTTLE_USERS_LIST_LIMIT=20
THROTTLE_USERS_LIST_TTL=60

# Users list (GET /users) pagination
USERS_LIST_DEFAULT_LIMIT=20
USERS_LIST_MAX_LIMIT=100

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Auth / JWT
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_LOGIN_MAX_FAILED_ATTEMPTS=5
AUTH_LOGIN_LOCKOUT_MINUTES=15
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# In production (HTTPS): COOKIE_SECURE=true

# Registration / login email confirmation.
# These are only defaults: an admin can override each one at runtime via
# PATCH /admin/settings/auth (stored in the `settings` table). While a
# database value exists, changing the env var has no effect — reset the
# field with `null` to fall back to env again.
AUTH_REGISTER_REQUIRE_EMAIL_CONFIRMATION=false
AUTH_REGISTER_CONFIRMATION_METHOD=otp
AUTH_LOGIN_REQUIRE_EMAIL_CONFIRMATION=false
AUTH_LOGIN_CONFIRMATION_METHOD=otp

# Email change / account deletion confirmation (env only)
AUTH_EMAIL_CHANGE_CONFIRMATION_METHOD=otp
DELETE_ACCOUNT_CONFIRMATION_METHOD=otp

# Email verification
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_INTERVAL_SECONDS=60
OTP_LENGTH=6

# Password policy
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_REQUIRE_COMPLEXITY=false

# Mailer (Mailpit locally)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_FROM=noreply@example.com

# File transformation storage: `local` (disk) or `s3` (AWS S3 / RustFS)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# S3 — used only when STORAGE_DRIVER=s3. Empty values fail validation, so keep
# them commented out until needed. Values below match the local RustFS from
# docker compose (`npm run storage:up`, console at http://localhost:9001);
# compose reads the same bucket/region/keys from .env.
# STORAGE_S3_BUCKET=prism-files
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ENDPOINT=http://localhost:9000
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_ACCESS_KEY_ID=rustfsadmin
# STORAGE_S3_SECRET_ACCESS_KEY=rustfsadmin
# On AWS: leave ENDPOINT, FORCE_PATH_STYLE and both keys unset (IAM role credentials)

# Bootstrap admin (run once via `npm run seed:admin` after first migration:run)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Transformations: timeout in milliseconds, throttle TTL in seconds, sizes in bytes.
TRANSFORM_TIMEOUT_MS=30000
THROTTLE_TRANSFORM_LIMIT=10
THROTTLE_TRANSFORM_TTL=60
# CSV / JSON / XML: 10 MiB; YAML: 5 MiB.
TRANSFORM_MAX_SIZE_CSV=10485760
TRANSFORM_MAX_SIZE_JSON=10485760
TRANSFORM_MAX_SIZE_XML=10485760
TRANSFORM_MAX_SIZE_YAML=5242880
# Text conversion: worker threads (queue = 4 x workers), max nesting depth and node count.
TRANSFORM_TEXT_WORKERS=2
TRANSFORM_TEXT_MAX_DEPTH=64
TRANSFORM_TEXT_MAX_NODES=1000000
# Image conversion. PNG / JPEG: 20 MiB; SVG: 2 MiB.
TRANSFORM_MAX_SIZE_PNG=20971520
TRANSFORM_MAX_SIZE_JPEG=20971520
TRANSFORM_MAX_SIZE_SVG=2097152
# Max input width x height, checked from the header before decoding (~7000x7000);
# also the total budget for PNG/JPEG embedded in an SVG.
IMAGE_MAX_INPUT_PIXELS=50000000
# SVG rasterization: max output size, px.
IMAGE_SVG_MAX_WIDTH=4096
IMAGE_SVG_MAX_HEIGHT=4096
# Transformation history: entries older than this are not returned.
TRANSFORMATIONS_RETENTION_DAYS=90
# History rate limits (TTL in seconds): self and admin endpoints.
THROTTLE_TRANSFORMATIONS_HISTORY_LIMIT=30
THROTTLE_TRANSFORMATIONS_HISTORY_TTL=60
THROTTLE_ADMIN_TRANSFORMATIONS_HISTORY_LIMIT=20
THROTTLE_ADMIN_TRANSFORMATIONS_HISTORY_TTL=60
# JPEG output quality (1-100) when the request passes none.
IMAGE_JPEG_DEFAULT_QUALITY=80
