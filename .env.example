# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false
# HEALTH_DISK_PATH is optional — defaults to "/" on Linux/macOS or "C:\" on Windows
# HEALTH_DISK_PATH=/
HEALTH_DISK_THRESHOLD=0.9

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# Auth / JWT
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# File transformation storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
